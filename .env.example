# Base URL of the Disciplinary Measures API.
# Matches the backend's "https" launch profile (src/DisciplinaryMeasures.Api).
# Use http://localhost:5113 to talk to the plain-HTTP profile instead.
VITE_API_BASE_URL=https://localhost:7113

# Display name used across the UI (sign-in screen, sidebar).
VITE_COMPANY_NAME=Your Company

# Convention enforced on employee identifiers, e.g. "EMP" -> EMP00123.
# Leave empty to accept any identifier.
VITE_EMPLOYEE_ID_PREFIX=

# Email domain required for company accounts, e.g. "company.com".
# Leave empty to accept any domain.
VITE_COMPANY_EMAIL_DOMAIN=
