# Base URL of the Disciplinary Measures API (ASP.NET backend)
VITE_API_BASE_URL=https://localhost:7155

# Base URL of the optional messaging microservice used to send documents via WhatsApp
VITE_WHATSAPP_SERVICE_URL=http://localhost:3000

# Display name used across the UI and generated documents (letterhead, footer, etc.)
VITE_COMPANY_NAME=Your Company

# Convention enforced on employee identifiers, e.g. "EMP" -> EMP00123 (leave empty to disable)
VITE_EMPLOYEE_ID_PREFIX=EMP

# Email domain required for company accounts, e.g. "company.com" (leave empty to disable)
VITE_COMPANY_EMAIL_DOMAIN=company.com
